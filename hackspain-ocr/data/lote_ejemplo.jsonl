# Lote de ejemplo para comprobar el motor sin OCR ni ERP.
#
# Es EXACTAMENTE lo que tendrá que producir `parser.rs` (la `factura`) más el
# contexto de `erp.rs` (los `asientos`) y `excel.rs` (las `filas_excel`). Sirve
# para dos cosas:
#   1. Comprobar que el cableado funciona de punta a punta hoy.
#   2. Fijar el contrato de entrada del lote antes de que existan los módulos.
#
# Se admiten líneas vacías y comentarios `#`; el lote de verdad (`--pdf-dir`) no
# los tendrá. Los `score` son los del umbral de `config/reglas.toml` (0.85):
# por debajo, la extracción es dudosa y R5 escala.
#
# Uso: cargo run -- --fixture data/lote_ejemplo.jsonl --out outputs/outcomes_ejemplo.jsonl

# ─── 1. PAGAR (R6): asiento PENDIENTE, pedido y importe conciliados ───────────
# Caso de referencia, con los OCHO campos y su rastro completo. Fíjate en que
# `valor` va canónico (sin guion, en mayúsculas) y `crudo` tal cual se leyó: la
# normalización se guarda *además* del original, nunca en su lugar.
#
# Los dos identificadores del documento están aquí: `nif_emisor` (a quién se
# paga) y `cif_cliente` (a quién se factura). Omitir `cif_cliente` no es un caso
# neutro: la factura sale ESCALAR por R1 bis, porque sin él no está completa como
# documento fiscal. Las líneas de abajo que no lo llevan lo omiten a propósito
# solo cuando otra regla anterior ya ha decidido.
{"file_id":"factura_5518.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO","valor":"B12345678","rastro":{"crudo":"NIF: B-12345678","score":0.99,"origen":{"fuente":"OCR","pagina":0,"linea":3}}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98,"origen":{"fuente":"OCR","pagina":0,"linea":6}}},"pedido":{"estado":"ENCONTRADO","valor":"PED-2024-0912","rastro":{"crudo":"Pedido: PED-2024-0912","score":0.97,"origen":{"fuente":"OCR","pagina":0,"linea":5}}},"numero_factura":{"estado":"ENCONTRADO","valor":"F-2024-5518","rastro":{"crudo":"Factura n  F-2024-5518","score":0.96,"origen":{"fuente":"OCR","pagina":0,"linea":2}}},"fecha":{"estado":"ENCONTRADO","valor":"2024-09-02","rastro":{"crudo":"Fecha: 02/09/2024","score":0.95,"origen":{"fuente":"OCR","pagina":0,"linea":4}}},"base":{"estado":"ENCONTRADO","valor":"1020.25","rastro":{"crudo":"Base 1.020,25","score":0.98,"origen":{"fuente":"OCR","pagina":0,"linea":8}}},"iva":{"estado":"ENCONTRADO","valor":"214.25","rastro":{"crudo":"IVA 21% 214,25","score":0.98,"origen":{"fuente":"OCR","pagina":0,"linea":9}}},"total":{"estado":"ENCONTRADO","valor":"1234.50","rastro":{"crudo":"TOTAL 1.234,50 EUR","score":0.99,"origen":{"fuente":"OCR","pagina":0,"linea":10}}}},"asientos":[{"asiento_id":"AS-00412","nif":"B12345678","pedido":"PED-2024-0912","importe":"1234.50","estado":"PENDIENTE","proveedor":"Suministros Ibericos S.L.","fecha":"2024-09-03"}]}

# ─── 2. NO_PAGAR (R3): el ERP manda, el asiento ya está PAGADA ────────────────
{"file_id":"factura_5519.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO","valor":"B12345678","rastro":{"crudo":"NIF: B-12345678","score":0.99,"origen":{"fuente":"OCR","pagina":0,"linea":3}}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98}},"pedido":{"estado":"ENCONTRADO","valor":"PED-2024-0913","rastro":{"crudo":"Pedido: PED-2024-0913","score":0.97}},"total":{"estado":"ENCONTRADO","valor":"480.00","rastro":{"crudo":"TOTAL 480,00 EUR","score":0.99}}},"asientos":[{"asiento_id":"AS-00413","nif":"B12345678","pedido":"PED-2024-0913","importe":"480.00","estado":"PAGADA","proveedor":"Suministros Ibericos S.L."}]}

# ─── 3. ESCALAR (R7): asiento PENDIENTE pero los importes descuadran ──────────
{"file_id":"factura_5520.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO","valor":"B12345678","rastro":{"crudo":"NIF: B-12345678","score":0.99}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98}},"pedido":{"estado":"ENCONTRADO","valor":"PED-2024-0914","rastro":{"crudo":"Pedido: PED-2024-0914","score":0.97}},"total":{"estado":"ENCONTRADO","valor":"1234.50","rastro":{"crudo":"TOTAL 1.234,50 EUR","score":0.99}}},"asientos":[{"asiento_id":"AS-00414","nif":"B12345678","pedido":"PED-2024-0914","importe":"1200.00","estado":"PENDIENTE"}]}

# ─── 4. ESCALAR (R5): el NIF se leyó pero no se pudo canonizar ────────────────
# ILEGIBLE, no NO_APARECE: la diferencia importa. El OCR *vio* algo que parecía
# un NIF y no se pudo canonizar, así que no se sabe a quién se está pagando.
# Nótese que el pedido SÍ está, así que R1 no salta: decide R5, con el crudo y
# la línea exacta en el motivo, que es lo que permite ir a mirar la factura.
{"file_id":"factura_5521.pdf","factura":{"nif_emisor":{"estado":"ILEGIBLE","rastro":{"crudo":"NIF: B1234567B","score":0.62,"origen":{"fuente":"OCR","pagina":0,"linea":3}}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98}},"pedido":{"estado":"ENCONTRADO","valor":"PED-2024-0915","rastro":{"crudo":"Pedido: PED-2024-0915","score":0.97,"origen":{"fuente":"OCR","pagina":0,"linea":5}}},"total":{"estado":"ENCONTRADO","valor":"950.00","rastro":{"crudo":"TOTAL 950,00 EUR","score":0.99}}},"asientos":[{"asiento_id":"AS-00415","nif":"B12345678","pedido":"PED-2024-0915","importe":"950.00","estado":"PENDIENTE"}]}

