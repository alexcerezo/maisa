# ─── 9. PAGAR (R6 por Estrategia 2): sin pedido, cuadra por NIF + importe ─────
# El pedido NO_APARECE es legítimo: no extraerlo no es un fallo de calidad (de
# eso se encarga R1, y aquí el NIF sí está). El asiento se empareja por NIF y
# importe, así que `match_por` será BY_NIF_Y_IMPORTE y no EXACT_BY_PEDIDO.
{"file_id":"factura_5526.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO","valor":"B12345678","rastro":{"crudo":"NIF: B-12345678","score":0.94,"origen":{"fuente":"OCR","pagina":0,"linea":3}}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98}},"total":{"estado":"ENCONTRADO","valor":"2110.00","rastro":{"crudo":"TOTAL 2.110,00 EUR","score":0.99}}},"asientos":[{"asiento_id":"AS-00418","nif":"B12345678","pedido":"PED-2024-0920","importe":"2110.00","estado":"PENDIENTE"}]}

# ─── 10. La línea que revienta: ESCALAR con el motivo de la excepción ─────────
# `ENCONTRADO` exige valor y rastro. Aquí falta el valor, así que el propio
# `Identificador` la rechaza al deserializar y la factura sale ESCALAR con
# "excepción: ..." en vez de tumbar el lote. Es la comprobación de que las
# invariantes de coherencia del tipo se defienden solas en la frontera de datos.
{"file_id":"factura_5527.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO"},"total":{"estado":"ENCONTRADO","valor":"100.00","rastro":{"crudo":"TOTAL 100,00 EUR","score":0.99}}}}
