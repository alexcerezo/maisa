# ─── 7. ESCALAR (R8): no consta en el ERP, pero el Excel tiene filas ──────────
# El Excel no es verdad, así que no basta para pagar; lo que hace es decir *dónde
# mirar*, y eso va en el motivo.
{"file_id":"factura_5524.pdf","factura":{"nif_emisor":{"estado":"ENCONTRADO","valor":"B12345678","rastro":{"crudo":"NIF: B-12345678","score":0.99}},"cif_cliente":{"estado":"ENCONTRADO","valor":"A58231074","rastro":{"crudo":"Cliente: Banco Miralmar S.A. · CIF: A58231074","score":0.98}},"total":{"estado":"ENCONTRADO","valor":"305.00","rastro":{"crudo":"TOTAL 305,00 EUR","score":0.99}}},"asientos":[],"filas_excel":[{"id":"Hoja1#77","nif":"B12345678","pedido":null,"importe":"305.00","estado":"PENDIENTE","crudo":{"PROVEEDOR":"Suministros Ibericos S.L.","IMPORTE":"305,00"}}]}

