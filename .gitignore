target
.vscode
.venv
.venv-api
500-*/*.md
/data


# Credenciales de MongoDB (nunca versionar)
.env
maisa/.env

# Copias de seguridad de la base de datos
backups/
*.archive

# Salida del lote de ejemplo: se regenera y NO es una entrega.
# (`outputs/outcomes.jsonl` sí se versiona: esa SÍ es la entrega.)
maisa/outputs/outcomes_ejemplo.jsonl

# Traza encadenada: material de auditoría que se regenera en cada pasada y
# lleva marca de tiempo, así que versionarla ensuciaría el repo en cada run.
maisa/outputs/*_traza.jsonl


# Restos de Python (el descargador del ERP y validate_jsonl.py son stdlib)
__pycache__/
*.pyc

# Cache de pytest (tests de la API en maisa/api) y salida de pytest volcada a
# mano en la raiz para inspeccionarla. Ninguna de las dos es una entrega.
.pytest_cache/
.pytest_out.txt

# Cache de OCR del motor: se regenera en cada pasada (una entrada por hash de
# PDF) y solo acelera el arranque, no es codigo ni dato de la entrega.
maisa/motor/.cache/

# Material de terceros clonado para consulta (referencias/maisa-hackaton es un
# fixture de test ajeno, no codigo nuestro). Se clona a mano y NO se versiona:
# meter un repo anidado aqui dentro es justo lo que rompe un `git add -A`.
referencias/

# Artefactos de Node (maisa/ui): dependencias instaladas y bundle compilado.
# NUNCA se versionan. Se colaron una vez en el commit del lote 2: un
# `git add -A` arrastro 2.224 ficheros de node_modules y los 505 del build de
# vite, y hubo que rehacer el commit antes de publicarlo. Estas reglas son la
# red que lo impide la proxima vez.
node_modules/
dist/
*.log

# Zona de trabajo suelta: NO forma parte de la entrega (la entrega son
# exactamente 3 ficheros en la raiz del repo publico). Se ignora para que un
# `git add -A` no la arrastre nunca.
_scratch/

# Artefactos temporales de la importacion a Mongo (los genera
# importar_asientos_mongo.py)
asientos.json
asientos.ndjson
snapshot_meta.json
# --- Nada de reconocimiento de equipos rivales en el repo publico ---------
# El trabajo de campo sobre los repos de los demas equipos vive SOLO en el
# workspace local (`recon/`, con `RECON_MAISA.md` y `PLAN_VICTORIA.md` dentro) y
# en el watcher de `~/.cache/maisa-watch/`. No es un artefacto de la entrega: si
# apareciera aqui, publicariamos datos de terceros. Estas reglas son una red de
# seguridad, no una invitacion a ignorar el criterio.
#
# `_scratch/` es la otra zona local: salidas de diagnostico, experimentos y
# material del workspace viejo que no forma parte del proyecto.
recon/
RECON_*.md
*rival*
*oraculo*
oracle.json
analisis-rivales*
comparativa-*
briefings/
digests/
pending-delta.md
latest-delta.md
maisa-watch*

# Claves API de OCI / certificados
*.pem

# Claves locales (nunca se commitean)
.env.local
.env.*.local
