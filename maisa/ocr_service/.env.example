# ---------------------------------------------------------------------------
# Configuracion del OCR API
#
# Perfil por defecto medido sobre 4 PDFs reales (2 facturas escaneadas limpias,
# 1 escaneo mixto y 1 fax degradado) en ARM64 de 2 nucleos. El factor decisivo
# de calidad no es el modelo de reconocimiento sino la RESOLUCION DE RENDER
# (ver OCR_PDF_SCALE mas abajo): una vez corregida, mobile empata en calidad
# con server y es 2.8x mas rapido.
# ---------------------------------------------------------------------------

# Perfil por defecto (recomendado para 2 nucleos):
#   Det: PP-OCRv5 mobile
#   Rec: PP-OCRv5 mobile
#
# Medido a escala 4.0 sobre los 4 documentos (server vs mobile):
#   server  27.77 s   64 lineas   score 0.9177   alnum 91.70%
#   mobile   9.91 s   65 lineas   score 0.9219   alnum 91.78%   <- 2.80x mas rapido
#
# Otros perfiles utiles (cambia y reinicia, sin rebuild):
#   Maxima precision: OCR_REC_MODEL_TYPE=server   (2.8x mas lento, +76 MB de
#                     modelo; historico: a escala 2.0 leia mejor los escaneos
#                     degradados, ventaja que desaparece al renderizar a 4.0)
#   Deteccion fina  : OCR_DET_MODEL_TYPE=server   (383 ms -> 6.6x mas lento)
#   PP-OCRv6        : OCR_DET_VERSION=PP-OCRv6 OCR_DET_MODEL_TYPE=small
#                     OCR_REC_VERSION=PP-OCRv6 OCR_REC_MODEL_TYPE=medium
#
# Nota: las metricas publicadas de PP-OCRv6 usan otro set de evaluacion, no son
# comparables 1:1 con las de PP-OCRv5.

# --- Deteccion ---
OCR_DET_VERSION=PP-OCRv5
OCR_DET_MODEL_TYPE=mobile

# --- Reconocimiento ---
OCR_REC_VERSION=PP-OCRv5
OCR_REC_MODEL_TYPE=mobile

# --- Clasificador de orientacion (lineas giradas 180 grados) ---
OCR_USE_CLS=true

# --- Inferencia ---
# Resolucion de entrada de la deteccion (multiplo de 32).
# 960 = buen equilibrio en documentos. Sube a 1280 para texto muy pequeno.
OCR_DET_LIMIT_SIDE_LEN=960

# Score minimo para conservar una linea detectada.
OCR_TEXT_SCORE=0.5

# ---------------------------------------------------------------------------
# Escala de renderizado de PDFs.  ESTE ES EL PARAMETRO CRITICO
# ---------------------------------------------------------------------------
# El reconocedor reescala cada recorte a 48 px de alto. A 144 dpi (escala 2.0)
# las lineas de un fax degradado miden ~20 px, asi que se amplian 2.4x por
# interpolacion y el texto se destruye: el modelo devuelve puntuacion suelta
# ("...", "…") con scores altos.
#
# Medido sobre 4 PDFs reales (2 nucleos ARM64, rec=server):
#   escala 2.0 (144 dpi) -> fax: 0% de caracteres alfanumericos (basura)
#   escala 4.0 (288 dpi) -> fax: 89.8%   (factura legible, totales correctos)
#   escala 5.0 (360 dpi) -> fax: 90.9%
# Los escaneos limpios son insensibles (86.8% -> 87.2%) y solo pagan ~20% mas
# de tiempo, asi que arrancar en 4.0 sale gratis y arregla los degradados.
OCR_PDF_SCALE=4.0

# --- Escalada automatica (red de seguridad) ---
# Si tras la primera pasada el texto no parece real (poca proporcion de
# alfanumericos) se reintenta a OCR_AUTO_SCALE_MAX. Con PDF_SCALE=4.0 la
# escalera es [4.0, 5.0], asi que solo se paga si 4.0 falla.
OCR_AUTO_SCALE=true
OCR_AUTO_SCALE_MAX=5.0

# Umbral de "texto creible" (% de alfanumericos). 0.5 separa limpio el ruido
# (0-4%) del texto real (85-94%).
OCR_MIN_ALPHA_RATIO=0.5

# Tope de pixeles por pagina (evita agotar memoria en A3 a escala alta).
OCR_MAX_PIXELS=2.4e7

# ---------------------------------------------------------------------------
# OCR en la nube (PaddleOCR-VL en Baidu AI Studio)  --  MOTOR PRIMARIO
# ---------------------------------------------------------------------------
# Flujo: se envia el documento como job asincrono, se sondea el estado y se
# descarga un JSONL con el resultado en Markdown por pagina.
#
# IMPORTANTE: este token es un SECRETO. .env esta en .gitignore. Si el fichero
# se comparte o se sube a un repo, rota el token en AI Studio.
#
# Sin token (vacio) el servicio arranca igual: usa siempre el motor local.
OCR_ENGINE=auto
OCR_CLOUD_ENABLED=true
OCR_CLOUD_TOKEN=
OCR_CLOUD_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR_CLOUD_MODEL=PaddleOCR-VL-1.6

# Preprocesado opcional del lado del servidor. Desactivado: anade latencia y
# el caso de uso es texto, no reconstruccion de layout.
OCR_CLOUD_DOC_ORIENTATION=false
OCR_CLOUD_DOC_UNWARPING=false
OCR_CLOUD_CHART_RECOGNITION=false

# Tiempos. OJO con CONNECT_TIMEOUT: no es solo el tiempo de conexion. En
# `requests` ese valor se queda en el socket y acaba gobernando tambien la
# ESCRITURA del cuerpo, es decir la subida del fichero. Medido contra esta API
# con el fax de 249 KB:
#   CONNECT_TIMEOUT=10  -> subieron 1 de cada 3 (17-23 s reales cada subida)
#   CONNECT_TIMEOUT=60  -> subieron 3 de 3
# El enlace a Baidu va a ~12 KB/s, asi que 10 s se queda corto. El error que
# aparece, "The write operation timed out", enganya: parece red caida y es el
# propio limite de tiempo. Con 60 s no se pierde nada porque la sonda TCP de
# abajo detecta antes el caso de host realmente inalcanzable.
OCR_CLOUD_CONNECT_TIMEOUT=60
OCR_CLOUD_READ_TIMEOUT=120
# Sonda TCP previa: si el host no acepta conexion en este tiempo, se falla
# rapido y se pasa al motor local sin esperar los 60 s de arriba por intento.
OCR_CLOUD_PROBE_TIMEOUT=5
# Deadline del job completo (subida + cola + inferencia). Un PDF grande la
# puede necesitar por minutos.
OCR_CLOUD_JOB_TIMEOUT=600
OCR_CLOUD_POLL_INTERVAL=3
# Reintentos de subida. Aunque los 60 s arreglan el problema medido, la red
# sigue siendo la red.
OCR_CLOUD_SUBMIT_ATTEMPTS=3

# Cortacircuitos: tras N fallos consecutivos no se intenta la nube durante
# COOLDOWN segundos, para no pagar el timeout en cada peticion cuando la API
# esta caida. Se va directo al motor local.
OCR_CLOUD_MAX_FAILURES=3
OCR_CLOUD_COOLDOWN=60

# Jobs simultaneos maximos contra la API (es E/S, no CPU).
OCR_CLOUD_MAX_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Archivos grandes
# ---------------------------------------------------------------------------
# Tamano maximo de subida en MB. Se corta la recepcion al superarlo (413).
OCR_MAX_UPLOAD_MB=300

# Paginas maximas por documento (0 = sin limite).
OCR_MAX_PAGES=0

# Directorio de trabajo para los ficheros temporales. Si se mapea a un volumen
# del host, los temporales no viven en la capa de escritura de Docker.
OCR_TMP_DIR=/tmp/ocr-work

# --- Logging ---
LOG_LEVEL=INFO
