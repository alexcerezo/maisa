# Plantilla de variables de entorno para docker-compose.yml.
# Uso:  cp .env.example .env   y rellenar los valores.
# El fichero .env NO se versiona (está en .gitignore).

# --- Usuario administrador (solo para inicialización y mantenimiento) ---
MONGO_ROOT_USER=albertitos_admin
MONGO_ROOT_PASSWORD=cambiame_en_produccion

# --- Usuario de aplicación (mínimo privilegio: readWrite sobre albertitos) ---
MONGO_APP_USER=albertitos_app
MONGO_APP_PASSWORD=cambiame_tambien

# --- Conexión ---
MONGO_PORT=27017
MONGO_DB=albertitos

# Cadena de conexión del usuario de aplicación, lista para consumir
# (la lee el motor: `src/main.rs`, y el README la documenta).
# OJO: 127.0.0.1 solo sirve para procesos de la MÁQUINA ANFITRIONA. Un
# contenedor de la red `albertitos_net` debe usar el host `mongo:27017` y
# añadir `directConnection=true`, porque el miembro anunciado del replica set
# es 127.0.0.1:27017 (ver docker-compose.yml, MONGO_RS_HOST).
MONGO_URI=mongodb://albertitos_app:<MONGO_APP_PASSWORD>@127.0.0.1:27017/albertitos?replicaSet=rs0&authSource=albertitos

# --- Clasificador Jev (maisa/jev/) ---
# Clave del AI Gateway de Vercel. Con ella, Jev sale a 0 hasta el 25 de
# septiembre de 2026 (promocion); despues vuelve a $0.042 por millon de
# tokens de entrada. La cuenta necesita una tarjeta en fichero para que el
# Gateway sirva peticiones, aunque el modelo este en promocion.
# Se saca de https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=