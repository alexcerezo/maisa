# Plantilla de variables de entorno para docker-compose.yml.
# Uso:  cp .env.example .env   y rellenar los valores.
# El fichero .env NO se versiona (está en .gitignore).

# --- Usuario administrador (solo para inicialización y mantenimiento) ---
MONGO_ROOT_USER=albertitos_admin
MONGO_ROOT_PASSWORD=cambiame_en_produccion

# --- Usuario de aplicación (mínimo privilegio: readWrite sobre albertitos) ---
MONGO_APP_USER=albertitos_app
MONGO_APP_PASSWORD=cambiame_tambien

# --- Conexión ---
MONGO_PORT=27017
MONGO_DB=albertitos

# Cadena de conexión resultante (referencia):
# mongodb://albertitos_app:<MONGO_APP_PASSWORD>@127.0.0.1:27017/albertitos?replicaSet=rs0&authSource=albertitos