# ---------------------------------------------------------------------------
# Plantilla de configuracion de la API/BFF de Albertitos (maisa/api).
#
#   cp .env.example .env      # y ajusta lo que haga falta
#
# NO contiene secretos: la contrasena de Mongo vive en `maisa/.env`, que no se
# versiona. Aqui solo se dice QUE variables existen y QUE valor toman por
# defecto.
#
# OJO con los valores que llevan `&` (la URI de Mongo): van entre comillas. Sin
# comillas, un `source .env` en bash corta la linea en el `&` y la variable no
# llega a definirse. Docker Compose tambien acepta las comillas y las quita.
# ---------------------------------------------------------------------------

# --- Superficie expuesta ----------------------------------------------------
# Puerto publicado en la LAN (`0.0.0.0:${API_PORT}`). 8009 lo usa el ERP y 8866
# el OCR, por eso el defecto es 8010.
API_PORT=8010

# --- Detras de un proxy TLS -------------------------------------------------
# La API se publica por HTTPS a traves de `maisa/proxy` (Caddy). Al reenviar,
# Caddy anade `X-Forwarded-Proto`/`X-Forwarded-For`, pero uvicorn solo se cree
# esas cabeceras si la IP de origen esta en esta lista.
#
# Por defecto se confia en la subred de `albertitos_net` (donde vive Caddy).
# NO se pone `*`: eso dejaria que cualquiera que entre directo por el 8010
# falsifique `X-Forwarded-For`. Si la red se recrea con otro rango, ajustalo
# (se consulta con `docker network inspect albertitos_net`).
FORWARDED_ALLOW_IPS=172.20.0.0/16

# --- MongoDB (solo lectura desde la API) ------------------------------------
# La API NO recibe una URI completa: la construye con las piezas de abajo, de
# modo que la contrasena viva en un solo sitio (`maisa/.env`, que no se
# versiona y que docker-compose.yml inyecta como `env_file`).
#   MONGO_APP_USER / MONGO_APP_PASSWORD -> de maisa/.env (usuario de app,
#                                          readWrite solo sobre `albertitos`)
#   MONGO_HOST -> `mongo` dentro de la red Docker; 127.0.0.1 en el anfitrion
#   MONGO_REPLICA_SET / MONGO_DIRECT_CONNECTION -> replica set de 1 nodo.
#     `directConnection=true` es necesario porque el miembro anunciado del
#     replica set es 127.0.0.1:27017 y eso, desde otro contenedor, apuntaria a
#     si mismo.
# Si `MONGO_APP_USER` esta vacio (nadie copio maisa/.env) se usa una URI sin
# credenciales: la API arranca y /health muestra `mongo` en rojo.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
MONGO_DIRECT_CONNECTION=true
MONGO_DB=albertitos
# URI completa: SUSTITUTO de todo lo anterior. Si la defines, manda ella y se
# ignoran las piezas. docker-compose.yml la deja vacia a proposito para que no
# se cuele la de maisa/.env, que apunta a 127.0.0.1 (el propio contenedor).
# MONGO_URI="mongodb://<usuario>:<contrasena>@mongo:27017/albertitos?replicaSet=rs0&directConnection=true&authSource=albertitos"
# Tiempo maximo de seleccion de servidor. Corto a proposito: si Mongo no esta,
# la API debe degradarse en decimas, no colgarse.
MONGO_TIMEOUT_MS=1500

# --- OCR --------------------------------------------------------------------
# Nombre DNS del contenedor del OCR en la red compartida. En local:
# http://127.0.0.1:8866
OCR_URL=http://ocr-api:8866

# --- ERP (informativo) ------------------------------------------------------
# El simulador del ERP solo escucha en loopback del anfitrion. La API NO lo
# consulta (lo hace el motor): se publica en /api/meta como contexto.
ERP_URL=http://127.0.0.1:8009

# --- Datos en disco (solo lectura) ------------------------------------------
# Dentro del contenedor, los volumenes de docker-compose.yml.
OUTPUTS_DIR=/datos/outputs
FACTURAS_DIR=/datos/facturas
# Geometria del OCR para el resaltado del visor: la cache del motor
# (`maisa/motor/.cache/ocr`, versionada en git). Es la caja de cada linea de las
# 29 facturas escaneadas, que no tienen capa de texto donde buscar. Si no esta
# montada, esas facturas se siguen viendo pero sin resaltado: se avisa en
# `/api/meta` (`datos.ocr_cache_existe`) y en el log de arranque.
OCR_CACHE_DIR=/datos/ocr-cache
# Visor estatico: el BUILD del panel, no su codigo fuente. Vite lo deja en
# `maisa/ui/dist` con `npm run build` (o `npm ci && npm run build`). Si apunta a
# la carpeta del panel, `/` sirve la plantilla de Vite sin construir y el
# navegador da una pagina en blanco. Si esta vacio, `/` devuelve un mensaje
# informativo, que es lo correcto cuando el panel no se ha construido.
UI_DIR=/datos/ui/dist

# --- Seguridad --------------------------------------------------------------
# Lista blanca de origenes, separada por comas. Vacio = solo origenes locales.
# El visor se sirve desde el mismo origen, asi que normalmente no hace falta
# tocar esto. `*` se acepta pero desactiva las credenciales.
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Si se define, TODOS los endpoints salvo /health, /health/ready, /docs y
# /openapi.json exigen la cabecera `X-API-Key`. Si se deja vacio, la API
# arranca en MODO ABIERTO (lo avisa en el log y en /api/meta).
API_KEY=

# --- Limites y diagnostico --------------------------------------------------
# Dependencias que /health/ready considera criticas (503 si alguna falla).
CRITICAL_DEPS=mongo,ocr
HEALTH_TIMEOUT_S=2.0
# Tope del fichero que se acepta en POST /api/ocr y POST /api/facturas.
MAX_UPLOAD_MB=50
# Escritura: permite POST /api/facturas (GridFS + `expedientes` + `eventos`).
# Ponlo a 0 para dejar la API en solo lectura sin tocar el resto de endpoints.
SUBIDAS_HABILITADAS=1
DEFAULT_LIMIT=50
MAX_LIMIT=500
# Longitud maxima del texto de busqueda (q / proveedor). Evita patrones costosos.
MAX_QUERY_LEN=64
LOG_LEVEL=INFO
