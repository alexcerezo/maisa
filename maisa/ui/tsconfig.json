{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        /* Estricto a propósito: los tipos de este proyecto son la frontera entre los
       carriles de trabajo en paralelo (datos / tabla / detalle). Un `any` que se
       cuela aquí se convierte en un bug de otro. */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        /* Vite compila y emite; `tsc` solo comprueba. Así el `build` falla por un tipo
       mal puesto antes de producir un bundle. */
        "noEmit": true,
        "types": [
            "vite/client",
            "node"
        ]
    },
    "include": [
        "src",
        "vite.config.ts"
    ]
}